<?xml version="1.0" encoding="UTF-8"?>
<!-- El sitio es una sola pagina en cuatro idiomas. Cada variante se declara
     como URL propia y todas se apuntan entre si con hreflang, que es lo que
     hace que Google sirva la version correcta segun el pais del visitante.

     La raiz sin parametro ES la italiana: los clientes son negocios de
     Fidenza y Parma. Por eso el x-default apunta ahi y el ingles tiene ahora
     su propia ?lang=en, igual que los otros dos.

     La pagina de privacidad no esta aqui a proposito: lleva noindex. Un
     sitemap que declara una pagina que pide no ser indexada es una
     contradiccion que Search Console marca como error. -->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
  <url>
    <loc>https://digitatex.com/</loc>
    <xhtml:link rel="alternate" hreflang="it" href="https://digitatex.com/"/>
    <xhtml:link rel="alternate" hreflang="en" href="https://digitatex.com/?lang=en"/>
    <xhtml:link rel="alternate" hreflang="es" href="https://digitatex.com/?lang=es"/>
    <xhtml:link rel="alternate" hreflang="fr" href="https://digitatex.com/?lang=fr"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="https://digitatex.com/"/>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://digitatex.com/?lang=en</loc>
    <xhtml:link rel="alternate" hreflang="it" href="https://digitatex.com/"/>
    <xhtml:link rel="alternate" hreflang="en" href="https://digitatex.com/?lang=en"/>
    <xhtml:link rel="alternate" hreflang="es" href="https://digitatex.com/?lang=es"/>
    <xhtml:link rel="alternate" hreflang="fr" href="https://digitatex.com/?lang=fr"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="https://digitatex.com/"/>
    <changefreq>weekly</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
    <loc>https://digitatex.com/?lang=es</loc>
    <xhtml:link rel="alternate" hreflang="it" href="https://digitatex.com/"/>
    <xhtml:link rel="alternate" hreflang="en" href="https://digitatex.com/?lang=en"/>
    <xhtml:link rel="alternate" hreflang="es" href="https://digitatex.com/?lang=es"/>
    <xhtml:link rel="alternate" hreflang="fr" href="https://digitatex.com/?lang=fr"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="https://digitatex.com/"/>
    <changefreq>weekly</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
    <loc>https://digitatex.com/?lang=fr</loc>
    <xhtml:link rel="alternate" hreflang="it" href="https://digitatex.com/"/>
    <xhtml:link rel="alternate" hreflang="en" href="https://digitatex.com/?lang=en"/>
    <xhtml:link rel="alternate" hreflang="es" href="https://digitatex.com/?lang=es"/>
    <xhtml:link rel="alternate" hreflang="fr" href="https://digitatex.com/?lang=fr"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="https://digitatex.com/"/>
    <changefreq>weekly</changefreq>
    <priority>0.9</priority>
  </url>
</urlset>
